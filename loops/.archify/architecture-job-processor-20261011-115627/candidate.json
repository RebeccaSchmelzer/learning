  "cards": [
    {
      "dot": "cyan",
      "title": "1 — API produces the job",
      "items": [
        "Validates task, payload.text, and max_attempts",
        "Stores status=queued and immediately returns 202 + job ID",
        "GET /jobs/{id} reads the same record for progress"
      ]
    },
    {
      "dot": "violet",
      "title": "2 — Worker consumes the job",
      "items": [
        "Polls independently; the API never executes the task",
        "BEGIN IMMEDIATE makes the claim exclusive across workers",
        "Runs the matching handler and captures its result"
      ]
    },
    {
      "dot": "emerald",
      "title": "3 — The record becomes the answer",
      "items": [
        "Success → completed with JSON result",
        "Error → queued after 2 seconds until max attempts, then failed",
        "Expired 30-second worker lease → recovered or failed"
      ]
    }
  ]
